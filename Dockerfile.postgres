# postgres + pgvector for the knowledge-base semantic layer (in-process
# embedder writes vectors; retrieval uses <=> cosine distance). Alpine base
# keeps musl so the data volume stays compatible with stock postgres:16-alpine.
# Alpine's packaged pgvector targets postgresql18, so we build it from source
# against this image's postgres 16 via PGXS.
FROM postgres:16-alpine AS pgvector-build
ARG PGVECTOR_VERSION=0.8.1
RUN apk add --no-cache build-base curl clang21 llvm21 \
 && curl -fsSL https://github.com/pgvector/pgvector/archive/refs/tags/v${PGVECTOR_VERSION}.tar.gz | tar xz \
 && make -C pgvector-${PGVECTOR_VERSION} && make -C pgvector-${PGVECTOR_VERSION} install

FROM postgres:16-alpine
COPY --from=pgvector-build /usr/local/lib/postgresql/vector.so /usr/local/lib/postgresql/
COPY --from=pgvector-build /usr/local/share/postgresql/extension/vector* /usr/local/share/postgresql/extension/
